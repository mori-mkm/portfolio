# Copy this file to .env.local and fill in real values there.
# .env.local (and any other .env* file) is gitignored — never commit real
# credentials. See docs/CONTACT_SETUP.md for how to obtain each value.

# Supabase — server-only, used by src/lib/supabase/admin.ts.
# SUPABASE_SECRET_KEY (the current sb_secret_... key format) bypasses Row
# Level Security: never expose it to the browser, never prefix it with
# NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend — server-only, used by src/app/api/contact/route.ts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Cloudflare Turnstile — used by src/lib/contact/turnstile.ts (server) and
# src/components/forms/ContactForm.tsx (client widget).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to expose to the browser — a
# Turnstile "site key" is designed to be public, unlike the secret key
# below. It's inlined into the client bundle at BUILD time, so it must be
# set before running `npm run build` / before Vercel's deploy build, not
# just added to a running server's environment afterward.
# TURNSTILE_SECRET_KEY must stay server-only. In production, if this is
# missing, the contact form fails closed (rejects all submissions) rather
# than silently skipping verification — see src/lib/contact/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
